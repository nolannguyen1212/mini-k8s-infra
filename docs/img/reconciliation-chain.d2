# render: d2 --layout=tala reconciliation-chain.d2 reconciliation-chain.svg
direction: right

git: "Git" {
  direction: down
  icon: https://cdn.simpleicons.org/git
  repo: "commit + push"
}

argocd: "ArgoCD" {
  direction: down
  icon: https://cdn.simpleicons.org/argo
  sync: "polls, detects diff"
  render: "kustomize build\n--enable-helm"
  sync -> render
}

k8s: "Kubernetes control plane" {
  direction: down
  icon: https://cdn.simpleicons.org/kubernetes
  apiserver: "apiserver\napplies manifests"
  controller: "Deployment controller\nreconciles Pod spec"
  scheduler: "Scheduler\nplaces Pod on node"
  apiserver -> controller -> scheduler
}

vault: "Vault" {
  direction: down
  icon: https://cdn.simpleicons.org/vault
  injector: "Agent Injector\n(webhook)"
  init: "init container\nrenders /vault/secrets/*"
  injector -> init: "adds init + sidecar"
}

miniflux: "Miniflux\ncontainer execs"

git.repo -> argocd.sync: "git push"
argocd.render -> k8s.apiserver: "applies manifests"
k8s.scheduler -> vault.injector: "before container starts"
vault.init -> miniflux: "sourced, then exec'd"
