// .vscode/settings.json
{
  "files.associations": {
    "**/charts/**/templates/*.yaml": "helm",
    "**/charts/**/templates/*.tpl": "helm"
  },
  "[helm]": {
    "editor.formatOnSave": false
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true
  },
  "yaml.schemas": {
    "kubernetes": ["k8s/**/*.yaml"]
  }
}